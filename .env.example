# ============================================================================
# Cosmetics B2B/B2C Distribution Platform - Environment Configuration
# ============================================================================

# Supabase Credentials (PostgreSQL Database)
SUPABASE_URL="https://your-supabase-project-id.supabase.co"
SUPABASE_KEY="your-supabase-anon-or-service-role-key"

# Google Gemini API Credentials (for OCR Vision & Telugu/English Copy Generation)
GEMINI_API_KEY="your-google-gemini-api-key"

# Google Maps / Places API Key (Optional: for live Places search in harvester.py)
GOOGLE_MAPS_API_KEY="your-google-maps-places-api-key"

# WhatsApp Cloud API & Voice SDK Configuration (for Phase 2 Sales Webhook)
WHATSAPP_CLOUD_API_TOKEN="your-whatsapp-cloud-api-bearer-token"
WHATSAPP_PHONE_ID="your-whatsapp-phone-id"

# Local Catalog Input Directory
RAW_INPUT_DIR="raw_input"
